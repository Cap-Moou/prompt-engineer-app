rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email'])
          && data.userId == request.auth.uid
          && data.email is string && data.email.size() <= 256
          && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
          && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'name', 'config', 'timestamp'])
          && data.userId == request.auth.uid
          && data.name is string && data.name.size() <= 100
          && data.config is map
          && data.timestamp is number;
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['userId', 'prompt', 'title', 'timestamp'])
          && data.userId == request.auth.uid
          && data.title is string && data.title.size() <= 100
          && data.prompt is string && data.prompt.size() <= 10000
          && data.timestamp is number;
    }

    // --- Match Groups ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);

      match /projects/{projectId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming());
        allow update: if isOwner(userId) && isValidProject(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'config', 'timestamp']);
        allow delete: if isOwner(userId);
      }

      match /library/{promptId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(promptId) && isValidPrompt(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
